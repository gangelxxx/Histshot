<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Histshot.Views"
        xmlns:l="clr-namespace:Histshot.Localization"
        x:Class="Histshot.Views.HistoryWindow"
        Title="{l:Localize History_Title}"
        Width="660"
        Height="460"
        MinWidth="520"
        MinHeight="320"
        RequestedThemeVariant="Dark"
        Background="#181818"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- Icon + text action buttons -->
        <Style Selector="Button.historyButton">
            <Setter Property="Background" Value="#2C2C2C" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Foreground" Value="#EDEDED" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.historyButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A3A3A" />
        </Style>
        <Style Selector="Button.historyButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#454545" />
        </Style>

        <!-- Destructive variant -->
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#B23A36" />
        </Style>
        <Style Selector="Button.danger:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#C84540" />
        </Style>

        <!-- Item card (no hover/press color changes: clicks inside a card —
             e.g. in the comment editor — must not repaint it) -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#232323" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#333333" />
        </Style>

        <!-- Clickable thumbnail -->
        <Style Selector="Border.thumb">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#3C3C3C" />
            <Setter Property="Background" Value="#0A0A0A" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.thumb:pointerover">
            <Setter Property="BorderBrush" Value="#4D9DE0" />
        </Style>

        <!-- Neutralize the Fluent focus chrome on the comment editor's inner border
             (the theme styles target the template's PART_BorderElement). -->
        <Style Selector="TextBox.commentBox /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#3C3C3C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#1A1A1A" />
        </Style>
        <Style Selector="TextBox.commentBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#4A4A4A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#1A1A1A" />
        </Style>
        <Style Selector="TextBox.commentBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#4A4A4A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#1A1A1A" />
        </Style>

        <!-- Search box: always-visible clear button while there is text -->
        <Style Selector="TextBox.searchBox:not(:empty)">
            <Setter Property="InnerRightContent">
                <Template>
                    <Button Command="{Binding $parent[TextBox].Clear}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4"
                            Margin="0,0,6,0"
                            Focusable="False"
                            Cursor="Hand">
                        <Path Data="M205.66 194.34a8 8 0 0 1-11.32 11.32L128 139.31l-66.34 66.35a8 8 0 0 1-11.32-11.32L116.69 128L50.34 61.66a8 8 0 0 1 11.32-11.32L128 116.69l66.34-66.35a8 8 0 0 1 11.32 11.32L139.31 128Z"
                              Fill="#9A9A9A"
                              Stretch="Uniform"
                              Width="9"
                              Height="9" />
                    </Button>
                </Template>
            </Setter>
        </Style>

        <!-- Floating action button: hidden until the pointer is over its hover host -->
        <Style Selector="Button.hoverAction">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Opacity" Value="0.95" />
        </Style>
        <Style Selector=".hoverHost:pointerover Button.hoverAction">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- Saved comment: a full-width delimited text area. MinHeight reserves room
             for the hover-revealed copy button, so its appearance never grows the area. -->
        <Style Selector="Border.commentTextArea">
            <Setter Property="Background" Value="#1A1A1A" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="MinHeight" Value="34" />
        </Style>

        <!-- Card highlighted after a reminder notification click -->
        <Style Selector="Border.card.highlighted">
            <Setter Property="Background" Value="#26303A" />
            <Setter Property="BorderBrush" Value="#4D9DE0" />
        </Style>

        <!-- Bell icon of a card with an active reminder -->
        <Style Selector="Button.hasReminder /template/ Path">
            <Setter Property="Fill" Value="#4D9DE0" />
        </Style>

    </Window.Styles>

    <Grid RowDefinitions="Auto,*" Margin="20,18">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,16">
            <TextBlock Grid.Column="0"
                       Text="{l:Localize ScreenshotHistory}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF"
                       VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     x:Name="SearchTextBox"
                     Classes="commentBox searchBox"
                     Width="220"
                     Margin="0,0,12,0"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"
                     FontSize="13"
                     Padding="8,5"
                     CornerRadius="8"
                     Foreground="#EDEDED"
                     FocusAdorner="{x:Null}"
                     PlaceholderText="{l:Localize SearchComments}"
                     PlaceholderForeground="#7F7F7F"
                     TextChanged="SearchTextBox_TextChanged" />
            <Button Grid.Column="2"
                    x:Name="ClearAllButton"
                    Classes="historyButton danger"
                    Click="ClearAllButton_Click"
                    ToolTip.Tip="{l:Localize Tip_RemoveAllScreenshots}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Path Data="M216 48h-40v-8a24 24 0 0 0-24-24h-48a24 24 0 0 0-24 24v8H40a8 8 0 0 0 0 16h8v144a16 16 0 0 0 16 16h128a16 16 0 0 0 16-16V64h8a8 8 0 0 0 0-16M96 40a8 8 0 0 1 8-8h48a8 8 0 0 1 8 8v8H96Zm96 168H64V64h128Zm-80-104v64a8 8 0 0 1-16 0v-64a8 8 0 0 1 16 0m48 0v64a8 8 0 0 1-16 0v-64a8 8 0 0 1 16 0"
                          Fill="#EDEDED"
                          Stretch="Uniform"
                          Width="15"
                          Height="15"
                          VerticalAlignment="Center" />
                    <TextBlock Text="{l:Localize ClearHistory}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Items (ItemsControl instead of ListBox: no selection, so clicks inside
             a card — e.g. in the comment editor — never select/flash the card) -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl x:Name="HistoryItems">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="views:HistoryItemViewModel">
                    <Border Classes="card" Classes.highlighted="{Binding IsHighlighted}">
                        <Grid RowDefinitions="Auto,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <!-- Clickable preview with a hover-revealed copy button -->
                                <Grid Grid.Column="0" Classes="hoverHost">
                                    <Border Classes="thumb"
                                            Width="116"
                                            Height="72"
                                            PointerPressed="Thumbnail_PointerPressed"
                                            ToolTip.Tip="{l:Localize Tip_PreviewOrEdit}">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                    </Border>
                                    <Button Classes="historyButton hoverAction"
                                            Tag="{Binding}"
                                            Click="CopyButton_Click"
                                            PointerPressed="OverlayButton_PointerPressed"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,5,5"
                                            ToolTip.Tip="{l:Localize Tip_CopyToClipboard}">
                                        <Path Data="M216 32H88a8 8 0 0 0-8 8v40H40a8 8 0 0 0-8 8v128a8 8 0 0 0 8 8h128a8 8 0 0 0 8-8v-40h40a8 8 0 0 0 8-8V40a8 8 0 0 0-8-8m-56 176H48V96h112Zm48-48h-32V88a8 8 0 0 0-8-8H96V48h112Z"
                                              Fill="#EDEDED"
                                              Stretch="Uniform"
                                              Width="13"
                                              Height="13"
                                              VerticalAlignment="Center" />
                                    </Button>
                                </Grid>

                                <!-- Meta -->
                                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding DateText}"
                                               FontSize="15"
                                               FontWeight="Medium"
                                               Foreground="#F2F2F2" />
                                    <TextBlock Text="{Binding TimeText}"
                                               FontSize="13"
                                               Foreground="#9A9A9A" />
                                    <TextBlock Text="{Binding ReminderText}"
                                               IsVisible="{Binding HasReminder}"
                                               FontSize="11"
                                               Foreground="#4D9DE0" />
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Classes="historyButton"
                                            Tag="{Binding}"
                                            Click="CommentButton_Click"
                                            ToolTip.Tip="{l:Localize Tip_CommentScreenshot}">
                                        <Path Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"
                                              Fill="#EDEDED"
                                              Stretch="Uniform"
                                              Width="15"
                                              Height="15"
                                              VerticalAlignment="Center" />
                                    </Button>
                                    <Button Classes="historyButton"
                                            Classes.hasReminder="{Binding IsReminderPending}"
                                            Tag="{Binding}"
                                            Click="ReminderButton_Click"
                                            ToolTip.Tip="{l:Localize Tip_Reminder}">
                                        <Path Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"
                                              Fill="#EDEDED"
                                              Stretch="Uniform"
                                              Width="15"
                                              Height="15"
                                              VerticalAlignment="Center" />
                                    </Button>
                                    <Button Classes="historyButton danger"
                                            Tag="{Binding}"
                                            Click="DeleteButton_Click"
                                            ToolTip.Tip="{l:Localize Tip_DeleteScreenshot}">
                                        <Path Data="M216 48h-40v-8a24 24 0 0 0-24-24h-48a24 24 0 0 0-24 24v8H40a8 8 0 0 0 0 16h8v144a16 16 0 0 0 16 16h128a16 16 0 0 0 16-16V64h8a8 8 0 0 0 0-16M96 40a8 8 0 0 1 8-8h48a8 8 0 0 1 8 8v8H96Zm96 168H64V64h128Zm-80-104v64a8 8 0 0 1-16 0v-64a8 8 0 0 1 16 0m48 0v64a8 8 0 0 1-16 0v-64a8 8 0 0 1 16 0"
                                              Fill="#EDEDED"
                                              Stretch="Uniform"
                                              Width="15"
                                              Height="15"
                                              VerticalAlignment="Center" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Comment: saved text and editor, full width below the main row -->
                            <StackPanel Grid.Row="1"
                                        IsVisible="{Binding ShowCommentArea}"
                                        Margin="0,10,0,0"
                                        Spacing="6">
                                <Border Classes="hoverHost commentTextArea"
                                        IsVisible="{Binding ShowCommentText}"
                                        DoubleTapped="CommentArea_DoubleTapped"
                                        ToolTip.Tip="{l:Localize Tip_DoubleClickToEdit}">
                                    <Grid>
                                        <TextBlock Text="{Binding Comment}"
                                                   FontSize="12"
                                                   FontStyle="Italic"
                                                   Foreground="#B9B9B9"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                        <Button Classes="historyButton hoverAction"
                                                Tag="{Binding}"
                                                Click="CopyCommentButton_Click"
                                                PointerPressed="OverlayButton_PointerPressed"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                ToolTip.Tip="{l:Localize Tip_CopyCommentToClipboard}">
                                            <Path Data="M216 32H88a8 8 0 0 0-8 8v40H40a8 8 0 0 0-8 8v128a8 8 0 0 0 8 8h128a8 8 0 0 0 8-8v-40h40a8 8 0 0 0 8-8V40a8 8 0 0 0-8-8m-56 176H48V96h112Zm48-48h-32V88a8 8 0 0 0-8-8H96V48h112Z"
                                                  Fill="#EDEDED"
                                                  Stretch="Uniform"
                                                  Width="13"
                                                  Height="13"
                                                  VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <Grid IsVisible="{Binding IsEditingComment}"
                                      ColumnDefinitions="*,Auto">
                                    <views:CommentTextBox Grid.Column="0"
                                             Classes="commentBox"
                                             Tag="{Binding}"
                                             Text="{Binding EditText}"
                                             EnterPressed="CommentTextBox_EnterPressed"
                                             PlaceholderText="{l:Localize CommentWatermark}"
                                             FontSize="13"
                                             Padding="8,5"
                                             CornerRadius="6"
                                             MinHeight="44"
                                             VerticalContentAlignment="Center"
                                             FocusAdorner="{x:Null}"
                                             Foreground="#EDEDED"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True" />
                                    <Button Grid.Column="1"
                                            Classes="historyButton"
                                            Tag="{Binding}"
                                            Click="SaveCommentButton_Click"
                                            Margin="6,0,0,0"
                                            Padding="9,5"
                                            ToolTip.Tip="{l:Localize Save}">
                                        <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                              Fill="#EDEDED"
                                              Stretch="Uniform"
                                              Width="14"
                                              Height="14"
                                              VerticalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
