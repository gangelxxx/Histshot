<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Histshot.Localization"
        x:Class="Histshot.Views.ReminderDialog"
        Title="{l:Localize Reminder_Title}"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        RequestedThemeVariant="Dark"
        Background="#181818"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="Button.historyButton">
            <Setter Property="Background" Value="#2C2C2C" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Foreground" Value="#EDEDED" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.historyButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A3A3A" />
        </Style>
        <Style Selector="Button.historyButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#454545" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#B23A36" />
        </Style>
        <Style Selector="Button.danger:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#C84540" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="20,18" Spacing="12">
        <Grid ColumnDefinitions="70,*">
            <TextBlock Grid.Column="0"
                       Text="{l:Localize Reminder_Date}"
                       VerticalAlignment="Center"
                       Foreground="#EDEDED"
                       FontSize="13" />
            <DatePicker Grid.Column="1"
                        x:Name="ReminderDatePicker"
                        Width="240"
                        HorizontalAlignment="Left" />
        </Grid>
        <Grid ColumnDefinitions="70,*">
            <TextBlock Grid.Column="0"
                       Text="{l:Localize Reminder_Time}"
                       VerticalAlignment="Center"
                       Foreground="#EDEDED"
                       FontSize="13" />
            <TimePicker Grid.Column="1"
                        x:Name="ReminderTimePicker"
                        Width="240"
                        HorizontalAlignment="Left" />
        </Grid>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,6,0,0">
            <Button x:Name="RemoveButton"
                    Classes="historyButton danger"
                    Content="{l:Localize Reminder_Remove}"
                    Click="RemoveButton_Click" />
            <Button Classes="historyButton"
                    Content="{l:Localize Cancel}"
                    Click="CancelButton_Click" />
            <Button Classes="historyButton"
                    Content="{l:Localize Save}"
                    IsDefault="True"
                    Click="SaveButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
