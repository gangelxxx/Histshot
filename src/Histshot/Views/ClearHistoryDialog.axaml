<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Histshot.Localization"
        x:Class="Histshot.Views.ClearHistoryDialog"
        Title="{l:Localize ClearHistoryDialog_Title}"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        RequestedThemeVariant="Dark"
        Background="#181818"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="Button.historyButton">
            <Setter Property="Background" Value="#2C2C2C" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Foreground" Value="#EDEDED" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.historyButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A3A3A" />
        </Style>
        <Style Selector="Button.historyButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#454545" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#B23A36" />
        </Style>
        <Style Selector="Button.danger:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#C84540" />
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="#EDEDED" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="20,18" Spacing="14">
        <TextBlock Text="{l:Localize ClearHistoryPrompt}"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="#EDEDED" />

        <TextBlock Text="{l:Localize KeepLastDays}"
                   FontSize="13"
                   Foreground="#9A9A9A" />

        <StackPanel x:Name="OptionsPanel" Spacing="6" Margin="4,0,0,0">
            <RadioButton GroupName="Keep" Tag="1" Content="{l:Localize Keep1Day}" />
            <RadioButton GroupName="Keep" Tag="3" Content="{l:Localize Keep3Days}" />
            <RadioButton GroupName="Keep" Tag="7" IsChecked="True" Content="{l:Localize Keep7Days}" />
            <RadioButton GroupName="Keep" Tag="14" Content="{l:Localize Keep14Days}" />
            <RadioButton GroupName="Keep" Tag="30" Content="{l:Localize Keep30Days}" />
            <RadioButton GroupName="Keep" Tag="0" Content="{l:Localize KeepNone}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,4,0,0">
            <Button Classes="historyButton"
                    Content="{l:Localize Cancel}"
                    Click="CancelButton_Click" />
            <Button Classes="historyButton danger"
                    Content="{l:Localize Delete}"
                    IsDefault="True"
                    Click="DeleteButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
